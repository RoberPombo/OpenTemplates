#!/bin/sh
# main solo se actualiza por Pull Request desde develop/propósito.
# Uso: pnpm hooks  (una vez por clon) para activar core.hooksPath.

protected="refs/heads/main"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "$protected" ] || continue
  # Borrar la rama remota tampoco está permitido.
  case "$local_sha" in
    0000000000000000000000000000000000000000) action="borrar main" ;;
    *) action="empujar $local_ref a main" ;;
  esac
  echo "✋ Bloqueado: $action" >&2
  echo "   main solo se mueve con un PR (develop -> main). Crea una rama y abre el PR." >&2
  blocked=1
done

exit "$blocked"
