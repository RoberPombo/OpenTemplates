{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTemplates",
  "version": "0.2.0",
  "identifier": "com.alukard.opentemplates",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenTemplates",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "deb"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "RoberPombo",
    "homepage": "https://github.com/RoberPombo/OpenTemplates",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "utils"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/RoberPombo/OpenTemplates/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCQzMxMjYxRjlBOTlENjkKUldScG5hbjVZUkxEeStXQnVQUnpDYW1WY0x4TGM5TUZzQ29vSCtlcnE5T3dJSk5zeDlzRitrV2kK"
    }
  }
}
